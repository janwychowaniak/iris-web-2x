+/* iris-web-2x: the Overview's columns, shown or hidden by the user and remembered in the
+   browser. The defaults come from the page (data-iw2x-columns), else they are those of 2.4.29. */
+const IW2X_COLUMNS = ['outcome', 'case_id', 'severity', 'title', 'customer', 'classification',
+                      'state', 'tags', 'open_since', 'open_date', 'tasks', 'owner'];
+const IW2X_COLUMNS_2_4_29 = ['title', 'customer', 'classification', 'state', 'tags', 'open_since',
+                             'open_date', 'tasks', 'owner'];
+const IW2X_TITLE = 3;
+const IW2X_TOGGLED = [0, 1, 2, 4, 5, 6, 7, 8, 9, 10, 11];
+const IW2X_COLUMNS_KEY = 'iw2x.overview.columns';
+let iw2x_columns_applying = false;
+let iw2x_filter_fields = [];
+
+function iw2x_columns_defaults() {
+    let ids = ($('#overview_table').attr('data-iw2x-columns') || '').split(',');
+    if (!ids.every((id) => IW2X_COLUMNS.includes(id))) {
+        ids = IW2X_COLUMNS_2_4_29;
+    }
+    return IW2X_COLUMNS.map((id, i) => i === IW2X_TITLE || ids.includes(id));
+}
+
+function iw2x_columns_stored() {
+    try {
+        let stored = JSON.parse(window.localStorage.getItem(IW2X_COLUMNS_KEY));
+        return (stored && typeof stored === 'object' && !Array.isArray(stored)) ? stored : {};
+    } catch (e) {
+        return {};
+    }
+}
+
+function iw2x_columns_apply(api, visible) {
+    iw2x_columns_applying = true;
+    try {
+        visible.forEach((v, i) => {
+            if (api.column(i).visible() !== v) {
+                api.column(i).visible(v, false);
+            }
+        });
+    } finally {
+        iw2x_columns_applying = false;
+    }
+    api.columns.adjust();
+}
+
+/* From initComplete, once tableFiltering has given every column, all visible then, its field;
+   DataTables keeps a hidden column's header cells, with their fields, for when it is shown. */
+function iw2x_columns_init(api) {
+    iw2x_filter_fields = api.columns().indexes().toArray().map((i) =>
+        $('#overview_table .filters th').eq($(api.column(i).header()).index()).find('input'));
+    let defaults = iw2x_columns_defaults();
+    let stored = iw2x_columns_stored();
+    iw2x_columns_apply(api, IW2X_COLUMNS.map((id, i) =>
+        i === IW2X_TITLE || (typeof stored[id] === 'boolean' ? stored[id] : defaults[i])));
+}
+
+function iw2x_columns_save(api) {
+    let choice = {};
+    IW2X_COLUMNS.forEach((id, i) => {
+        if (i !== IW2X_TITLE) {
+            choice[id] = api.column(i).visible();
+        }
+    });
+    try {
+        window.localStorage.setItem(IW2X_COLUMNS_KEY, JSON.stringify(choice));
+    } catch (e) { }
+}
+
+/* Default columns: the defaults again, and the choice forgotten. */
+function iw2x_columns_default(api) {
+    try {
+        window.localStorage.removeItem(IW2X_COLUMNS_KEY);
+    } catch (e) { }
+    iw2x_columns_apply(api, iw2x_columns_defaults());
+}
+
+/* A hidden column keeps no filter: its field is emptied and its search cleared. */
+function iw2x_columns_clear_filter(api, column) {
+    let field = iw2x_filter_fields[column];
+    if (field && field.val()) {
+        field.val('');
+        field.attr('title', '');
+    }
+    if (api.column(column).search() !== '') {
+        api.column(column).search('', false, true).draw();
+    }
+}
+
